# =====================================================================
# Environment configuration for the Hotel Booking system.
#
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
#
# NEVER commit the real `.env` file - it is listed in .gitignore.
#
# The same variable names are used locally (this file) and in
# production (Render environment variables).
# =====================================================================

# --- Server ------------------------------------------------------------
# Render injects PORT automatically. Locally it defaults to 3000.
PORT=3000
NODE_ENV=development

# --- MySQL connection -------------------------------------------------
# Use 127.0.0.1 (not "localhost"): on macOS "localhost" can resolve to
# ::1 which makes the MySQL client attempt an IPv6 connection first.
#
# On Aiven the values come from the "Connection" page of the service:
#   DB_HOST  = the Aiven host name, e.g. mysql-project-xxxx.aivencloud.com
#   DB_PORT  = 3306
#   DB_NAME  = the database name, e.g. dbname
#   DB_USER  = the restricted application user (not avnadmin)
#   DB_PASSWORD = the password of that user
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hotel_booking_db
DB_CONNECTION_LIMIT=10

# --- TLS (Aiven and other managed MySQL hosts) ------------------------
# DB_SSL=true turns on an encrypted connection.
# DB_SSL_CA accepts either the path to the ca.crt file or the PEM text
# itself. In Render it is easiest to paste the PEM text with the line
# breaks written as \n.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA=

# --- Browser access ----------------------------------------------------
# Comma separated list of browser origins that may call the API.
# "*" allows any origin and is convenient during local development.
# In production set the exact Vercel URL of the frontend.
CORS_ORIGIN=*
