{
  "name": "hotel-booking-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hotel Booking and Reservation Management System - DBMS mini project (MySQL 8+ / Node.js / Express)",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "test": "node --test tests/",
    "db:install": "bash database/run_all.sh",
    "db:lab": "mysql -uroot --table < database/09_ddl_lab.sql",
    "db:reports": "mysql -uroot --table < database/08_reports.sql",
    "db:backup": "bash database/backup.sh",
    "db:apply-remote": "bash database/deploy/apply_remote.sh",
    "db:verify-remote": "bash database/deploy/verify_remote.sh",
    "db:create-app-user": "bash database/deploy/create_app_user.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "hotel",
    "booking",
    "reservation",
    "dbms",
    "mysql"
  ],
  "license": "academic",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "mysql2": "^3.14.4"
  }
}
